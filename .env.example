# =====================================================================
#  Copiez ce fichier en ".env" puis remplissez les valeurs.
#  Le fichier .env est ignoré par Git : vos secrets ne seront pas publiés.
#  Ne partagez JAMAIS le contenu de .env (ni sur Discord, ni sur GitLab).
# =====================================================================

# --- Discord (obligatoire dès la V1) --------------------------------
# Token du bot : portail développeur Discord > votre application > Bot > Reset Token.
DISCORD_BOT_TOKEN=
# Identifiant du serveur « SAE · GAME DEV » (clic droit sur le serveur > Copier l'identifiant,
# après avoir activé le mode développeur dans Discord).
DISCORD_GUILD_ID=
# Rôle Discord autorisé à utiliser les commandes d'administration (groupes /admin et /refonte),
# en plus des membres qui ont la permission « Gérer le serveur ». Laisser vide pour ne pas l'utiliser.
ADMIN_ROLE_NAME=

# --- Base de données et journaux ------------------------------------
DATABASE_PATH=data/sae_bot.sqlite3
# DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO
# Met à jour automatiquement les messages permanents au démarrage (uniquement après un /admin installer confirmé).
AUTO_REFRESH_ON_STARTUP=true
# Épingle les messages permanents (nécessite la permission « Épingler des messages »).
PIN_PERMANENT_MESSAGES=true
# Recrée automatiquement, après quelques secondes, un message permanent supprimé à la main
# (uniquement après un /admin installer confirmé). false = il faut lancer /admin actualiser.
AUTO_RECREATE_DELETED_MESSAGES=true

# --- GitLab : notifications par webhooks (V2) -----------------------
# Guide complet : docs/gitlab-webhooks.md
# Secret partagé entre GitLab et le bot. VIDE = V2 DÉSACTIVÉE (le bot fonctionne comme en V1).
# Minimum 16 caractères. Pour en générer un :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Collez la même valeur dans GitLab > Settings > Webhooks > Secret token.
GITLAB_WEBHOOK_SECRET=
# Identifiant NUMÉRIQUE du projet GitLab (page d'accueil du projet, « Project ID »).
# Facultatif : s'il est rempli, les webhooks d'un autre projet sont refusés.
GITLAB_PROJECT_ID=
# Adresse d'écoute du serveur de webhooks. Gardez 127.0.0.1 avec un tunnel
# (Cloudflare, ngrok) : rien n'est alors exposé directement sur le réseau.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080

# --- GitHub : notifications du dépôt du jeu (webhooks) ----------------
# Guide : docs/github-webhooks.md. Indépendant de GitLab (autre secret, autre port).
# Secret partagé avec GitHub (Settings > Webhooks > Secret). VIDE = GITHUB DÉSACTIVÉ.
# Minimum 16 caractères, généré comme GITLAB_WEBHOOK_SECRET (commande ci-dessus).
GITHUB_WEBHOOK_SECRET=
# Seul dépôt accepté (comparaison exacte). Les webhooks d'un autre dépôt sont refusés (403).
GITHUB_WEBHOOK_REPOSITORY=ElBastiano7553/game-project
# Adresse et port d'écoute : port DIFFÉRENT de WEBHOOK_PORT (GitLab).
GITHUB_WEBHOOK_HOST=127.0.0.1
GITHUB_WEBHOOK_PORT=8081

# --- Projets enregistrés : réception commune (multi-projets, étape B3) ---
# Guide : docs/projets-reception.md. N'affecte pas les webhooks GitHub et GitLab ci-dessus.
# false par défaut : rien n'écoute. Aucun projet ne reçoit d'événement avant d'être relié (/projet configurer).
PROJECTS_HTTP_ENABLED=false
# Adresse locale uniquement (127.0.0.1, ::1 ou localhost) : l'accès depuis Internet passe par Nginx.
PROJECTS_HTTP_HOST=127.0.0.1
# Port différent de WEBHOOK_PORT et de GITHUB_WEBHOOK_PORT.
PROJECTS_HTTP_PORT=8090
# Secret du webhook de la GitHub App (étape B4), différent de GITHUB_WEBHOOK_SECRET.
# VIDE = chemin /github/webhook fermé. Ne jamais le coller dans Discord.
GITHUB_APP_WEBHOOK_SECRET=

# --- Projets GitHub : connexion par la GitHub App (étape B4, /projet configurer) ---
# Guide : docs/github-app.md. Tout vide = connexion désactivée (le reste ne change pas).
# Il faut la réception ci-dessus (PROJECTS_HTTP_ENABLED=true + GITHUB_APP_WEBHOOK_SECRET)
# et une adresse HTTPS publique installée par le propriétaire du serveur (Nginx).
# Adresse publique, https:// sans chemin, par exemple https://samae.exemple.fr
PROJECTS_PUBLIC_URL=
# Nom court de l'App (adresse github.com/apps/<nom-court>) et son Client ID (publics).
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
# Client secret de l'App (secret, masqué dans les journaux). Aucune clé privée n'est nécessaire.
# Ne jamais le coller dans Discord.
GITHUB_APP_CLIENT_SECRET=

# --- Projets GitLab : connexion par une application OAuth (étape B5, /projet configurer projet:) ---
# Guide : docs/gitlab-app.md. Tout vide = connexion désactivée (le reste ne change pas, y compris
# GITLAB_WEBHOOK_SECRET ci-dessus). Il faut la réception (PROJECTS_HTTP_ENABLED=true) et
# PROJECTS_PUBLIC_URL (la même adresse que pour GitHub). Redirect URI de l'application :
# <PROJECTS_PUBLIC_URL>/gitlab/callback ; scopes : read_user et read_api seulement.
# Instance GitLab de l'application (https://gitlab.com si vide).
GITLAB_APP_URL=
# « Application ID » de l'application OAuth (public).
GITLAB_APP_CLIENT_ID=
# « Secret » de l'application (secret, masqué dans les journaux). Ne jamais le coller dans Discord.
GITLAB_APP_CLIENT_SECRET=

# --- Historique, statistiques et alertes (lot 2) ---------------------
# Guide : docs/history-and-stats.md
# Durée de conservation de l'historique GitLab, du journal d'administration et des erreurs.
# Minimum 30 jours (protection contre les doublons de webhooks). Défaut : 365.
HISTORY_RETENTION_DAYS=365
# Salon où publier une alerte quand une même erreur se répète (3 fois en 10 minutes) :
# une CLÉ de config/server.toml (ex. bilan_ia), pas un nom ni un identifiant Discord.
# Vide = aucune alerte (les erreurs restent visibles avec /activite evenements type:erreurs).
# Après /refonte, la valeur conseillée est logs (salon #bot-logs, catégorie ADMINISTRATION privée).
ALERTS_CHANNEL=

# --- Accueil des nouveaux membres (1.4.0) -------------------------------
# Guide : docs/accueil-et-roles.md. Le choix des rôles (/roles) fonctionne sans ces réglages.
# true = message d'accueil dans #bienvenue à chaque arrivée (texte : content/accueil.toml).
# Exige d'activer « Server Members Intent » dans le portail développeur Discord (Bot >
# Privileged Gateway Intents), sinon le bot refuse de démarrer.
WELCOME_ON_JOIN=false
# Suppression automatique du message d'accueil après ce nombre d'heures (0 = jamais, 168 au plus).
WELCOME_DELETE_AFTER_HOURS=24

# --- Sauvegardes (lot 4) ----------------------------------------------
# Guide : docs/deployment-linux.md §5. Une copie vérifiée est aussi faite avant chaque migration.
# Dossier des sauvegardes. Vide = <dossier de la base>/backups.
BACKUP_DIR=
# Nombre de sauvegardes automatiques conservées (minimum 1). Défaut : 14.
BACKUP_KEEP=14
# Intervalle entre deux sauvegardes automatiques, en heures. 0 = désactivées. Défaut : 24.
BACKUP_INTERVAL_HOURS=24

# --- Surveillance du serveur (VPS, service systemd) -------------------
# Guide : docs/deployment-vps.md §8. Webhook Discord d'un salon d'administration
# (Paramètres du salon > Intégrations > Webhooks). Utilisé par « python -m src.ops check --alert »
# toutes les 5 minutes, même quand le bot est arrêté. Vide = alertes dans les journaux seulement.
# C'est un secret : il permet d'écrire dans le salon.
ALERT_WEBHOOK_URL=

# --- GitLab : API en lecture seule (lot 3, utilisée par /ia relecture) ------
# Guide : docs/ai.md. Nécessite aussi GITLAB_PROJECT_ID ci-dessus.
GITLAB_BASE_URL=https://gitlab.com
# Token en LECTURE SEULE : Settings > Access tokens, rôle Reporter, scope read_api uniquement.
# Vide = /ia relecture indisponible (le reste fonctionne).
GITLAB_ACCESS_TOKEN=

# --- IA générative (lot 3) : /ia question, /ia bilan, /ia relecture ------------------
# Guide : docs/ai.md
# none (défaut) = IA désactivée, le bot démarre normalement sans clé.
# anthropic = Claude (clé ci-dessous). fake = réponses de test, sans clé ni réseau.
AI_PROVIDER=none
# Clé d'API Anthropic (console.anthropic.com > API Keys). Obligatoire si AI_PROVIDER=anthropic.
AI_API_KEY=
# Vide = claude-opus-5-5. Moins cher : claude-sonnet-5-5 ou claude-haiku-5-5.
AI_MODEL=
# Demandes par jour pour toute l'équipe, et délai (secondes) entre deux demandes d'un membre.
AI_DAILY_LIMIT=50
AI_COOLDOWN_SECONDS=20
