# =====================================================================
#  Copiez ce fichier en ".env" puis remplissez les valeurs.
#  Le fichier .env est ignoré par Git : vos secrets ne seront pas publiés.
#  Ne partagez JAMAIS le contenu de .env (ni sur Discord, ni sur GitLab).
# =====================================================================

# --- Discord (obligatoire dès la V1) --------------------------------
# Token du bot : portail développeur Discord > votre application > Bot > Reset Token.
DISCORD_BOT_TOKEN=
# Identifiant du serveur « SAE · GAME DEV » (clic droit sur le serveur > Copier l'identifiant,
# après avoir activé le mode développeur dans Discord).
DISCORD_GUILD_ID=
# Rôle Discord autorisé à utiliser les commandes d'administration (/setup, /refresh, /config, /announce, /admin),
# en plus des membres qui ont la permission « Gérer le serveur ». Laisser vide pour ne pas l'utiliser.
ADMIN_ROLE_NAME=

# --- Base de données et journaux ------------------------------------
DATABASE_PATH=data/sae_bot.sqlite3
# DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO
# Met à jour automatiquement les messages permanents au démarrage (uniquement après un /setup confirmé).
AUTO_REFRESH_ON_STARTUP=true
# Épingle les messages permanents (nécessite la permission « Épingler des messages »).
PIN_PERMANENT_MESSAGES=true
# Recrée automatiquement, après quelques secondes, un message permanent supprimé à la main
# (uniquement après un /setup confirmé). false = il faut lancer /refresh.
AUTO_RECREATE_DELETED_MESSAGES=true

# --- GitLab : notifications par webhooks (V2) -----------------------
# Guide complet : docs/gitlab-webhooks.md
# Secret partagé entre GitLab et le bot. VIDE = V2 DÉSACTIVÉE (le bot fonctionne comme en V1).
# Minimum 16 caractères. Pour en générer un :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Collez la même valeur dans GitLab > Settings > Webhooks > Secret token.
GITLAB_WEBHOOK_SECRET=
# Identifiant NUMÉRIQUE du projet GitLab (page d'accueil du projet, « Project ID »).
# Facultatif : s'il est rempli, les webhooks d'un autre projet sont refusés.
GITLAB_PROJECT_ID=
# Adresse d'écoute du serveur de webhooks. Gardez 127.0.0.1 avec un tunnel
# (Cloudflare, ngrok) : rien n'est alors exposé directement sur le réseau.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080

# --- Historique, statistiques et alertes (lot 2) ---------------------
# Guide : docs/history-and-stats.md
# Durée de conservation de l'historique GitLab, du journal d'administration et des erreurs.
# Minimum 30 jours (protection contre les doublons de webhooks). Défaut : 365.
HISTORY_RETENTION_DAYS=365
# Salon où publier une alerte quand une même erreur se répète (3 fois en 10 minutes) :
# une CLÉ de config/server.toml (ex. bilan_ia), pas un nom ni un identifiant Discord.
# Vide = aucune alerte (les erreurs restent visibles avec /events type:erreurs).
# Après /refonte, la valeur conseillée est logs (salon #bot-logs, catégorie ADMINISTRATION privée).
ALERTS_CHANNEL=

# --- Sauvegardes (lot 4) ----------------------------------------------
# Guide : docs/deployment-linux.md §5. Une copie vérifiée est aussi faite avant chaque migration.
# Dossier des sauvegardes. Vide = <dossier de la base>/backups.
BACKUP_DIR=
# Nombre de sauvegardes automatiques conservées (minimum 1). Défaut : 14.
BACKUP_KEEP=14
# Intervalle entre deux sauvegardes automatiques, en heures. 0 = désactivées. Défaut : 24.
BACKUP_INTERVAL_HOURS=24

# --- Surveillance du serveur (VPS, service systemd) -------------------
# Guide : docs/deployment-vps.md §8. Webhook Discord d'un salon d'administration
# (Paramètres du salon > Intégrations > Webhooks). Utilisé par « python -m src.ops check --alert »
# toutes les 5 minutes, même quand le bot est arrêté. Vide = alertes dans les journaux seulement.
# C'est un secret : il permet d'écrire dans le salon.
ALERT_WEBHOOK_URL=

# --- GitLab : API en lecture seule (lot 3, utilisée par /review) ------
# Guide : docs/ai.md. Nécessite aussi GITLAB_PROJECT_ID ci-dessus.
GITLAB_BASE_URL=https://gitlab.com
# Token en LECTURE SEULE : Settings > Access tokens, rôle Reporter, scope read_api uniquement.
# Vide = /review indisponible (le reste fonctionne).
GITLAB_ACCESS_TOKEN=

# --- IA générative (lot 3) : /ask, /summary, /review ------------------
# Guide : docs/ai.md
# none (défaut) = IA désactivée, le bot démarre normalement sans clé.
# anthropic = Claude (clé ci-dessous). fake = réponses de test, sans clé ni réseau.
AI_PROVIDER=none
# Clé d'API Anthropic (console.anthropic.com > API Keys). Obligatoire si AI_PROVIDER=anthropic.
AI_API_KEY=
# Vide = claude-opus-5-5. Moins cher : claude-sonnet-5-5 ou claude-haiku-5-5.
AI_MODEL=
# Demandes par jour pour toute l'équipe, et délai (secondes) entre deux demandes d'un membre.
AI_DAILY_LIMIT=50
AI_COOLDOWN_SECONDS=20
