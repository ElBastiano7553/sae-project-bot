# Configuration d'exemple de Lavalink 4.2.2 pour Samae (docs/music.md, docs/music-vps-checklist.md).
# À copier en /opt/lavalink/application.yml par le PROPRIÉTAIRE du serveur, après relecture.
# Vérifiée le 25/10/2026 : Lavalink 4.2.2 démarre avec ce fichier, écoute sur 127.0.0.1 seulement,
# refuse toute requête sans mot de passe (401) et n'active ni la source « http » ni la source « local ».
#
# AUCUN SECRET ICI : le mot de passe est lu dans la variable d'environnement LAVALINK_SERVER_PASSWORD
# (fichier /etc/lavalink/lavalink.env, lisible seulement par root et le groupe lavalink). Le bot utilise
# la même valeur dans LAVALINK_PASSWORD (.env de Samae).

server:
  # Écoute LOCALE uniquement : Samae est sur la même machine, rien n'est exposé sur Internet.
  address: 127.0.0.1
  port: 2333
  http2:
    enabled: false

plugins:
  # Plugin YouTube officiel de l'équipe Lavalink (remplace la source YouTube intégrée, abandonnée).
  # Aucun compte Google, aucun jeton « poToken », aucun contournement : si YouTube bloque l'adresse
  # du serveur, la recherche passe à la source suivante de MUSIC_SOURCES (SoundCloud par défaut).
  youtube:
    enabled: true
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true
    clients:
      - MUSIC
      - ANDROID_VR
      - WEB
      - WEBEMBEDDED

lavalink:
  # Plugins : AUCUN téléchargement automatique. Le fichier youtube-plugin-1.18.2.jar est déposé à la main
  # dans plugins/ après vérification de son empreinte SHA-256 (docs/music-vps-checklist.md, étape 4) :
  # Lavalink charge les .jar de ce dossier au démarrage. Version figée, jamais « latest ».
  pluginsDir: "./plugins"
  server:
    # password : NE PAS l'écrire ici, voir LAVALINK_SERVER_PASSWORD ci-dessus.
    sources:
      youtube: false      # remplacé par le plugin ci-dessus
      soundcloud: true
      bandcamp: true
      twitch: false
      vimeo: false
      nico: false
      # Sécurité : jamais d'adresse arbitraire ni de fichier du serveur (protection en plus du filtre de Samae).
      http: false
      local: false
    soundcloud:
      # N'accepte pas les extraits de 30 secondes que SoundCloud renvoie pour les titres réservés aux abonnés.
      filterPreviewTracks: true
    filters:
      volume: true
      equalizer: false
      karaoke: false
      timescale: false
      tremolo: false
      vibrato: false
      distortion: false
      rotation: false
      channelMix: false
      lowPass: false
    bufferDurationMs: 400
    frameBufferDurationMs: 5000
    opusEncodingQuality: 10
    resamplingQuality: LOW
    trackStuckThresholdMs: 10000
    useSeekGhosting: true
    youtubePlaylistLoadLimit: 1   # pages de 100 titres ; Samae garde de toute façon MUSIC_MAX_PLAYLIST titres
    playerUpdateInterval: 5
    youtubeSearchEnabled: true
    soundcloudSearchEnabled: true
    gc-warnings: true

metrics:
  prometheus:
    enabled: false

sentry:
  dsn: ""

logging:
  file:
    path: ./logs/
  level:
    root: INFO
    lavalink: INFO
  request:
    enabled: false        # pas de journal des requêtes (elles contiennent les recherches des membres)
  logback:
    rollingpolicy:
      max-file-size: 10MB
      max-history: 14
      total-size-cap: 200MB
