# Site Nginx de Samae : réception des événements des projets enregistrés (multi-projets, étape B3).
#
# EXEMPLE À ADAPTER ET À INSTALLER PAR LE PROPRIÉTAIRE DU VPS, avec son accord : ce fichier n'est
# lu par rien tant qu'il n'est pas copié dans /etc/nginx/sites-available/ puis activé.
# Guide complet (vérifications, DNS, certificat, activation, retour arrière) : docs/projets-reception.md
#
# Remplacer samae.exemple.fr par le sous-domaine choisi (2 occurrences + chemins du certificat).
# Samae écoute sur 127.0.0.1:8090 (PROJECTS_HTTP_PORT) : seul Nginx y accède.

# Journal sans les paramètres d'adresse : les pages /github/setup, /github/callback et /gitlab/callback reçoivent
# des jetons à usage unique (state, code) qui n'ont rien à faire dans un fichier de journal.
log_format samae_sans_parametres '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

# 1) HTTP : seulement le défi Let's Encrypt (certbot --webroot), le reste part en HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name samae.exemple.fr;

    location /.well-known/acme-challenge/ {
        root /var/www/samae-acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# 2) HTTPS : à activer seulement APRÈS avoir obtenu le certificat (étape 4 du guide).
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name samae.exemple.fr;

    ssl_certificate     /etc/letsencrypt/live/samae.exemple.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/samae.exemple.fr/privkey.pem;

    client_max_body_size 2m;   # même limite que Samae
    access_log /var/log/nginx/samae.access.log samae_sans_parametres;
    error_log  /var/log/nginx/samae.error.log;
    server_tokens off;

    # Événements de la GitHub App (étape B4).
    location = /github/webhook {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 15s;
    }

    # Un webhook par projet GitLab (étape B5) : identifiant de 16 à 64 caractères.
    location ~ ^/gitlab/webhook/[A-Za-z0-9_-]{16,64}$ {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 15s;
    }

    # Pages de retour de la connexion GitHub (étape B4) : lecture seule, GET uniquement.
    location ~ ^/github/(setup|callback)$ {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;   # Samae interroge GitHub avant de répondre
    }

    # Page de retour de la connexion GitLab (étape B5) : GET uniquement. Elle affiche une seule fois
    # le secret du webhook : jamais de cache, et la page ne doit passer par aucun autre proxy.
    location = /gitlab/callback {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_read_timeout 30s;   # Samae interroge GitLab avant de répondre
    }

    # Tout le reste : rien.
    location / {
        return 404;
    }
}
